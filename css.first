
/* تنظیمات کلی صفحه */
body {
    font-family: Tahoma, sans-serif;
    background: linear-gradient(135deg, #e3f2fd, #bbdefb);
    margin: 0;
    padding: 0;
    text-align: center;
}

/* طراحی سربرگ */
header {
    background: linear-gradient(to left, #1565c0, #42a5f5);
    color: white;
    padding: 35px;
    box-shadow: 0 4px 10px #999;
}

/* عنوان اصلی */
h1 {
    font-size: 30px;
    letter-spacing: 1px;
}

/* بخش محتوا */
.content {
    background-color: white;
    width: 70%;
    margin: 60px auto;
    padding: 35px;
    border-radius: 20px;
    box-shadow: 0 5px 15px #aaa;
}

/* متن پاراگراف */
p {
    color: #555;
    font-size: 18px;
    line-height: 2;
}

/* طراحی دکمه */
button {
    background-color: #1565c0;
    color: white;
    padding: 14px 30px;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    cursor: pointer;
    transition: 0.3s;
}

/* افکت هنگام رفتن موس روی دکمه */
button:hover {
    background-color: #0d47a1;
    transform: scale(1.08);
}

/* تنظیم صفحه برای موبایل */
@media (max-width: 600px) {
    .content {
        width: 85%;
        padding: 20px;
    }

    h1 {
        font-size: 23px;
    }
}
